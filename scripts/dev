#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
if [ -x .tools/node/bin/node ]; then
  PATH="$PWD/.tools/node/bin:$PATH"
  export PATH
fi
if [ ! -x .venv/bin/uvicorn ] || [ ! -f frontend/node_modules/vite/bin/vite.js ]; then
  echo "Install the backend and frontend dependencies using README.md before starting DevMind." >&2
  exit 1
fi
.venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8000 --reload --reload-dir backend &
api_pid=$!
(cd frontend && exec node node_modules/vite/bin/vite.js --host 127.0.0.1 --port 5173) &
web_pid=$!
cleanup() {
  kill "$api_pid" "$web_pid" 2>/dev/null || true
  wait "$api_pid" "$web_pid" 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 0' INT TERM
while kill -0 "$api_pid" 2>/dev/null && kill -0 "$web_pid" 2>/dev/null; do
  sleep 1
done
exit 1
